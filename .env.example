# Never commit a real .env file or private key.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
DEPLOYER_PRIVATE_KEY=0xyour-private-key
# The signer must match TREASURY_ADDRESS for post-deploy treasury operations.
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
# Optional post-deployment amounts, in VSC. Defaults: 1000000 and 5000000.
STAKING_FUND_AMOUNT=1000000
ICO_SALE_AMOUNT=5000000
